{
    "name": "nearata/flarum-nodp",
    "description": "Prevent double posting into discussions.",
    "keywords": [
        "flarum",
        "prevent",
        "posting",
        "flood"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Hasan Özbey",
            "email": "hasanoozbey@gmail.com",
            "homepage": "https://github.com/the-turk"
        },
        {
            "name": "Nearata",
            "homepage": "https://nearata.com"
        }
    ],
    "support": {
        "source": "https://github.com/Nearata/flarum-nodp"
    },
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.8"
    },
    "require-dev": {
        "flarum/phpstan": "*",
        "laravel/pint": "*",
        "flarum/testing": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Nearata\\NoDP\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Prevent Double-Posting",
            "category": "feature",
            "icon": {
                "name": "far fa-clone",
                "backgroundColor": "#b72a2a",
                "color": "#fff"
            }
        }
    },
    "replace": {
        "the-turk/flarum-nodp": "*"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "format": "pint --dirty .",
        "test": ["@test:integration"],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/setup.php"
    }
}
